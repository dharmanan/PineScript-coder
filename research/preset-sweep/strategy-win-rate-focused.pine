//@version=6
// PineForge — Selective Multi-Timeframe, ISABET ODAKLI profil
// Olculen ayar: 15 dakikalik grafik, score >= 85, tetikleyici penceresi 1, RR 2,
//               trailing 1.5R'de baslar, 1.0R geriden takip eder
// Gelistirme 2019-2022: %50.2 isabet
// Dogrulama 2023-2025 :  744 islem, %46.9 isabet, +0.184R/islem
// 2026 holdout        :  180 islem, %43.3 isabet, +0.080R/islem
// GRAFIGI 15 DAKIKAYA ALIN. Baska zaman diliminde calistirmayin.
strategy("PineForge Selective — Win Rate Focused",
     overlay = true,
     pyramiding = 0,
     calc_on_order_fills = false,
     calc_on_every_tick = false,
     initial_capital = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.01,
     slippage = 0,
     // Pozisyon buyuklugu riske gore hesaplaniyor: (sermaye x %risk) / stop mesafesi.
     // BTC gibi yuksek fiyatli sembollerde bu, sermayeden buyuk bir nominal deger uretir.
     // Varsayilan %100 marjinle TradingView bu emirleri REDDEDER ve backtest sessizce
     // bos kalir. Burada olculen sey R katsayisi oldugu icin marjin serbest birakildi.
     margin_long = 1,
     margin_short = 1)

// ─────────── Girdiler ───────────
riskPercent   = input.float(1.0, "Islem basina risk (%)", minval = 0.1, step = 0.1, group = "Risk")
riskReward    = input.float(2.0, "Risk/odul", minval = 0.1, step = 0.5, group = "Risk")
atrLen        = input.int(14, "ATR uzunlugu", minval = 1, group = "Risk")
atrMultiple   = input.float(2.0, "ATR stop carpani", minval = 0.1, step = 0.1, group = "Risk")
trailStartR    = input.float(1.5, "Trailing baslangici (R)", minval = 0, step = 0.5, group = "Risk")
trailDistanceR = input.float(1.0, "Trailing mesafesi (R)", minval = 0.1, step = 0.5, group = "Risk")

scoreThreshold = input.int(85, "Minimum sinyal skoru", minval = 0, maxval = 100, group = "Sinyal")
triggerWindow  = input.int(1, "Tetikleyici penceresi (mum)", minval = 1, group = "Sinyal")
cooldownBars   = input.int(5, "Sinyal bekleme suresi (mum)", minval = 0, group = "Sinyal")

emaFastLen = input.int(20, "Hizli EMA", minval = 1, group = "Gostergeler")
emaSlowLen = input.int(50, "Yavas EMA", minval = 1, group = "Gostergeler")
longMaLen  = input.int(100, "Uzun MA", minval = 1, group = "Gostergeler")
rsiLen     = input.int(14, "RSI uzunlugu", minval = 2, group = "Gostergeler")
rsiLong    = input.float(55, "RSI long esigi", group = "Gostergeler")
rsiShort   = input.float(45, "RSI short esigi", group = "Gostergeler")
adxLen     = input.int(14, "ADX uzunlugu", minval = 2, group = "Gostergeler")
adxThresh  = input.float(20, "ADX esigi", group = "Gostergeler")
volLen     = input.int(20, "Hacim ortalamasi", minval = 1, group = "Gostergeler")
volMult    = input.float(1.2, "Hacim carpani", minval = 0.1, step = 0.05, group = "Gostergeler")
htf        = input.timeframe("240", "Ust zaman dilimi", group = "Gostergeler")
htfLen     = input.int(100, "Ust zaman dilimi EMA", minval = 1, group = "Gostergeler")

// ─────────── Gostergeler ───────────
emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
longMa    = ta.sma(close, longMaLen)
vwapValue = ta.vwap(hlc3)
rsiValue  = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
[plusDI, minusDI, adxValue] = ta.dmi(adxLen, adxLen)
volAvg   = ta.sma(volume, volLen)
atrValue = ta.atr(atrLen)

// Kapanmis ust zaman dilimi mumu kullanilir; aksi halde gelecege bakilmis olur.
// Pine v6 bool serisine na() uygulatmadigi icin sayi olarak cekilir: 1 yukari, 0 asagi,
// na ise ust zaman dilimi henuz isiniyor demektir ve iki yon de puan almaz.
htfRaw   = request.security(syminfo.tickerid, htf, close[1] > ta.ema(close, htfLen)[1] ? 1.0 : 0.0, lookahead = barmerge.lookahead_on)
htfState = nz(htfRaw, -1.0)
htfReady = htfState >= 0.0
htfBull  = htfState == 1.0
htfBear  = htfState == 0.0

// ─────────── Sinyal skoru ───────────
// Her filtre veto etmek yerine puan katar. Toplam agirlik 145, skor 0-100'e normalize edilir.
longScoreRaw  = (emaFast > emaSlow ? 30 : 0) + (close > longMa ? 10 : 0) + (close > vwapValue ? 15 : 0) +
     (rsiValue >= rsiLong ? 15 : 0) + (macdLine > macdSignal and macdHist > 0 ? 15 : 0) +
     (adxValue >= adxThresh and plusDI > minusDI ? 25 : 0) + (volume >= volAvg * volMult ? 10 : 0) +
     (htfBull ? 25 : 0)
shortScoreRaw = (emaFast < emaSlow ? 30 : 0) + (close < longMa ? 10 : 0) + (close < vwapValue ? 15 : 0) +
     (rsiValue <= rsiShort ? 15 : 0) + (macdLine < macdSignal and macdHist < 0 ? 15 : 0) +
     (adxValue >= adxThresh and minusDI > plusDI ? 25 : 0) + (volume >= volAvg * volMult ? 10 : 0) +
     (htfBear ? 25 : 0)

longScore  = math.round(100.0 * longScoreRaw / 145)
shortScore = math.round(100.0 * shortScoreRaw / 145)

// ─────────── Tetikleyici + pencere ───────────
// Tetikleyici tek mumluk bir olay, filtreler ise yavas hareket eder. Pencere, tetiklenen
// bir sinyali birkac mum canli tutar. ta.barssince tetiklendigi mumda 0 doner.
longTrigger  = ta.crossover(close, emaFast)
shortTrigger = ta.crossunder(close, emaFast)
longAge  = ta.barssince(longTrigger)
shortAge = ta.barssince(shortTrigger)
longTriggerActive  = not na(longAge) and longAge < triggerWindow
shortTriggerActive = not na(shortAge) and shortAge < triggerWindow

var int lastSignalBar = na
cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

longSignal  = barstate.isconfirmed and longScore  >= scoreThreshold and longTriggerActive  and cooldownOk
shortSignal = barstate.isconfirmed and shortScore >= scoreThreshold and shortTriggerActive and cooldownOk
if longSignal or shortSignal
    lastSignalBar := bar_index

// ─────────── Risk, girisde donar ───────────
// Stop mesafesi sinyal mumunda hesaplanir ve dolum fiyatina uygulanir. Emir bu mumun
// kapanisinda verilir, bir sonraki mumun acilisinda dolar.
var float pendingRisk = na
var float riskUnit    = na
var float stopLevel   = na
var float targetLevel = na
var float bestR       = 0.0

flat = strategy.position_size == 0

if longSignal and flat
    pendingRisk := atrValue * atrMultiple
    if pendingRisk > 0
        qty = (strategy.equity * riskPercent / 100.0) / pendingRisk
        strategy.entry("Long", strategy.long, qty = qty)

if shortSignal and flat
    pendingRisk := atrValue * atrMultiple
    if pendingRisk > 0
        qty = (strategy.equity * riskPercent / 100.0) / pendingRisk
        strategy.entry("Short", strategy.short, qty = qty)

justFilled = strategy.position_size != 0 and strategy.position_size[1] == 0
if justFilled
    riskUnit := pendingRisk
    entryPrice = strategy.position_avg_price
    isLong = strategy.position_size > 0
    stopLevel   := isLong ? entryPrice - riskUnit : entryPrice + riskUnit
    targetLevel := isLong ? entryPrice + riskUnit * riskReward : entryPrice - riskUnit * riskReward
    bestR := 0.0

if strategy.position_size > 0
    strategy.exit("L-exit", "Long", stop = stopLevel, limit = targetLevel)
if strategy.position_size < 0
    strategy.exit("S-exit", "Short", stop = stopLevel, limit = targetLevel)

// Stop sadece lehe hareket eder. Bir mum, lehe hareketin stop dokunusundan once
// oldugunu kanitlayamaz, bu yuzden sikilastirma bir sonraki mum icin gecerli olur.
if strategy.position_size != 0 and not na(riskUnit) and riskUnit > 0
    isLongNow = strategy.position_size > 0
    entryNow  = strategy.position_avg_price
    excursion = isLongNow ? (high - entryNow) / riskUnit : (entryNow - low) / riskUnit
    if excursion > bestR
        bestR := excursion
    if trailStartR > 0 and bestR >= trailStartR
        trailed = isLongNow ? entryNow + (bestR - trailDistanceR) * riskUnit : entryNow - (bestR - trailDistanceR) * riskUnit
        stopLevel := isLongNow ? math.max(stopLevel, trailed) : math.min(stopLevel, trailed)

if strategy.position_size == 0
    riskUnit    := na
    stopLevel   := na
    targetLevel := na
    bestR       := 0.0

// ─────────── Gorseller ───────────
plot(emaFast, "Hizli EMA", color = color.aqua)
plot(emaSlow, "Yavas EMA", color = color.orange)
plot(longMa, "Uzun MA", color = color.yellow, linewidth = 2)
plot(stopLevel, "Stop", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(targetLevel, "Hedef", color = color.green, style = plot.style_linebr, linewidth = 2)
bgcolor(not htfReady ? na : htfBull ? color.new(color.green, 94) : color.new(color.red, 94), title = "Ust zaman dilimi yonu")

var int signalCount = 0
var int fillCount = 0
if longSignal or shortSignal
    signalCount += 1
if justFilled
    fillCount += 1

var table info = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "Profil", bgcolor = color.new(color.blue, 70), text_color = color.white)
    table.cell(info, 1, 0, "ISABET ODAKLI", text_color = color.white)
    table.cell(info, 0, 1, "Skor L / S")
    table.cell(info, 1, 1, str.tostring(longScore) + " / " + str.tostring(shortScore) + "  (min " + str.tostring(scoreThreshold) + ")")
    table.cell(info, 0, 2, "Grafik")
    table.cell(info, 1, 2, timeframe.period == "15" ? "15dk DOGRU" : "15 DAKIKAYA ALIN",
         text_color = timeframe.period == "15" ? color.lime : color.red)
    table.cell(info, 0, 3, "Sinyal / Dolan")
    table.cell(info, 1, 3, str.tostring(signalCount) + " / " + str.tostring(fillCount),
         text_color = signalCount > 0 and fillCount < signalCount * 0.8 ? color.orange : color.white)
    table.cell(info, 0, 4, "Ust dilim hazir")
    table.cell(info, 1, 4, htfReady ? "EVET" : "ISINIYOR",
         text_color = htfReady ? color.lime : color.red)
